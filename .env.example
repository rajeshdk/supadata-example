# ==============================================================================
# Supa Agent Starter - Environment Configuration
# Copy this file to .env.local and populate the values below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supadata SDK Configuration (Required for live video transcripts & web scraping)
# Get your free API key at: https://supadata.ai
# ------------------------------------------------------------------------------
SUPADATA_API_KEY=your_supadata_api_key_here

# Optional: Override the default Supadata API base URL (defaults to https://api.supadata.ai)
# SUPADATA_BASE_URL=https://api.supadata.ai

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration (Required for agent reasoning & tool calling)
# Standard OpenAI API key or any OpenAI-compatible provider (Groq, OpenRouter, Ollama)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Model name (Default: gpt-4o-mini)
# Recommended fast models: gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom OpenAI-compatible endpoint URL
# Examples:
# - Groq: https://api.groq.com/openai/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Ollama (local): http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. Development / Demo Settings
# Set to 'true' to enable interactive simulation mode if you don't have API keys yet.
# When true, the agent provides simulated realistic responses demonstrating the UI & tool calling flow.
# ------------------------------------------------------------------------------
MOCK_AGENT_MODE=false
